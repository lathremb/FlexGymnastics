---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<nav class="mobile-bar" aria-label="Quick actions">
  <a href={site.links.enroll} class="mobile-bar__enroll"><Icon name="star" size={20} /> Enroll</a>
  <a href={`tel:${site.phones.main.tel}`}><Icon name="phone" size={20} /> Call</a>
  <a href={`sms:${site.phones.text.tel}`}><Icon name="sms" size={20} /> Text</a>
</nav>

<style>
  .mobile-bar {
    position: fixed; inset: auto 0 0 0; z-index: 90; display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 8px;
    padding: 8px 12px calc(8px + env(safe-area-inset-bottom)); background: rgb(255 255 255 / 96%);
    backdrop-filter: blur(10px); border-top: 1px solid var(--line); box-shadow: 0 -6px 20px rgb(30 12 56 / 10%);
  }
  .mobile-bar a {
    display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; border-radius: 999px;
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.9rem;
    text-decoration: none; color: var(--purple-700); background: var(--purple-50);
  }
  .mobile-bar .mobile-bar__enroll { background: var(--lime-400); color: var(--purple-950); }
  @media (min-width: 900px) { .mobile-bar { display: none; } }
</style>
