---
// Photo slot. Pass `src` once real gym photos are in /public/images/.
// Until then a branded placeholder renders with the alt text shown,
// so the owner can see exactly which shot belongs where.
interface Props {
  alt: string;
  src?: string;
  ratio?: string; // CSS aspect-ratio, e.g. '4/3'
  class?: string;
  eager?: boolean;
  tone?: 'purple' | 'lime' | 'lavender';
  position?: string; // CSS object-position, e.g. 'center top'
}
const { alt, src, ratio = '4/3', class: cls, eager = false, tone = 'purple', position = 'center' } = Astro.props;
---
{src ? (
  <img
    class:list={['photo', cls]}
    src={src}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    style={`aspect-ratio:${ratio};object-position:${position}`}
  />
) : (
  <div class:list={['photo', 'photo--placeholder', `photo--${tone}`, cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={alt}>
    <span class="photo__label" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="m21 17-5-5-8 7"/></svg>
      Photo: {alt}
    </span>
  </div>
)}

<style>
  .photo { width: 100%; object-fit: cover; border-radius: var(--radius-lg); display: block; }
  .photo--placeholder {
    position: relative; overflow: hidden; display: flex; align-items: flex-end; padding: 16px;
    background:
      radial-gradient(circle at 20% 15%, rgb(255 255 255 / 18%) 0 18%, transparent 19%),
      radial-gradient(circle at 85% 80%, rgb(146 208 80 / 45%) 0 22%, transparent 23%),
      linear-gradient(135deg, var(--purple-600), var(--purple-800));
    color: #fff;
  }
  .photo--lime { background: radial-gradient(circle at 80% 20%, rgb(255 255 255 / 30%) 0 20%, transparent 21%), linear-gradient(135deg, var(--lime-400), var(--lime-500)); color: var(--purple-950); }
  .photo--lavender { background: radial-gradient(circle at 15% 85%, rgb(146 208 80 / 50%) 0 18%, transparent 19%), linear-gradient(135deg, var(--purple-300), var(--purple-400)); color: var(--purple-950); }
  .photo__label {
    display: inline-flex; align-items: center; gap: 8px; font-size: var(--fs-xs); font-weight: 700;
    background: rgb(0 0 0 / 22%); padding: 6px 12px; border-radius: 999px; max-width: 100%; line-height: 1.3;
  }
  .photo--lime .photo__label, .photo--lavender .photo__label { background: rgb(255 255 255 / 55%); }
  .photo__label svg { flex: none; }
</style>
