---
// Cross-links between age-group pages. Pass `exclude` with the current page key.
interface Props { exclude?: string[]; heading?: string }
const { exclude = [], heading = 'Looking for a different age group?' } = Astro.props;

const groups = [
  { key: 'parent-tot', label: 'Parent & Tot', ages: '1–3', href: '/parent-and-tots/' },
  { key: 'preschool', label: 'Preschool', ages: '3–5', href: '/preschool-gymnastics/' },
  { key: 'kinder', label: 'Kinder', ages: '5–6', href: '/preschool-gymnastics/#kinder' },
  { key: 'lil-ninja', label: "Lil' Ninja", ages: '3–5', href: '/ninjazone/#lil-ninja' },
  { key: 'ninjazone', label: 'NinjaZone', ages: '3–13', href: '/ninjazone/' },
  { key: 'girls', label: 'Girls Gymnastics', ages: '6+', href: '/girls-classes/' },
  { key: 'boys', label: 'Boys Gymnastics', ages: '6+', href: '/boys-classes/' },
].filter((g) => !exclude.includes(g.key));
---
<nav class="age-links" aria-label="Other age groups">
  <p class="age-links__heading">{heading}</p>
  <ul role="list">
    {groups.map((g) => (
      <li>
        <a href={g.href}>
          <span class="age-links__ages">{g.ages}</span>
          <span>{g.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .age-links__heading { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; margin-bottom: 14px; }
  .age-links ul { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; margin: 0; padding: 0; }
  .age-links a {
    display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 6px 18px 6px 6px; border-radius: 999px;
    border: 2px solid var(--line); background: #fff; text-decoration: none; color: var(--ink); font-weight: 800;
    transition: border-color .15s ease, background .15s ease;
  }
  .age-links a:hover { border-color: var(--purple-600); background: var(--purple-50); color: var(--ink); }
  .age-links__ages { display: grid; place-items: center; min-width: 48px; height: 36px; padding: 0 10px; border-radius: 999px; background: var(--purple-600); color: #fff; font-family: var(--font-display); font-size: 0.85rem; }
</style>
