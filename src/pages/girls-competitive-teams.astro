---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import ContactStrip from '../components/ContactStrip.astro';
---
<BaseLayout
  title="Girls Competitive Teams"
  description="Flex Gymnastics AZ girls competitive teams compete in USA Gymnastics Developmental Program (DP) Levels 2–9 and XCEL Bronze–Platinum+. Ages 5+. A team family since 1999."
>
  <PageHero
    eyebrow="USA Gymnastics · Ages 5+"
    title="Girls"
    accent="Competitive Teams"
    lead="Not just learning gymnastics… having fun and making friendships that last a lifetime!"
    chips={['USAG Developmental Program (DP)', 'USAG XCEL']}
    photoSrc="/images/team-medals-banner.webp"
    photoAlt="Flex girls competitive team wearing medals in front of the FLEX Gymnastics banner"
  >
    <a class="btn btn--primary" href="/team-development-for-girls/">Team Development</a>
    <a class="btn btn--ghost" href="/annual-calendar/">Season Calendar</a>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The pathway</p>
        <h2 class="heading-xl">From Team Prep <strong>to competition</strong></h2>
        <p class="lead">Our girls compete through the USA Gymnastics Developmental Program (DP) and USA Gymnastics XCEL.</p>
      </div>
      <div class="path">
        <div class="path__col card card--soft">
          <p class="eyebrow">Team Prep</p>
          <ul class="chips" role="list"><li>Hot Shots</li><li>SuperStars</li><li>SeniorStars</li><li>Pre-Teams</li></ul>
        </div>
        <span class="path__arrow" aria-hidden="true">→</span>
        <div class="path__col card card--dark">
          <p class="eyebrow">USAG DP</p>
          <p class="path__big">Levels 2–9</p>
        </div>
        <span class="path__arrow" aria-hidden="true">+</span>
        <div class="path__col card card--lime">
          <p class="eyebrow">USAG XCEL</p>
          <p class="path__big">Bronze – Platinum+</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container split">
      <Photo src="/images/team-pyramid.webp" alt="Flex team gymnasts posing together in a heart pyramid" ratio="1/1" class="photo--capped" />
      <div class="prose">
        <p class="eyebrow">Our history</p>
        <h2 class="heading-xl">A team family <strong>since 1999</strong></h2>
        <p>Our team began in 1999 with three Level 5s in its first season. Once you’re on the team, you are part of our family — and many team alumnae return as coaches.</p>
        <p class="quote">Not just learning gymnastics… having fun and making friendships that last a lifetime!</p>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container"><ContactStrip heading="Questions about team? Talk to us." /></div>
  </section>
</BaseLayout>

<style>
  .path { display: grid; gap: 16px; align-items: stretch; }
  @media (min-width: 900px) { .path { grid-template-columns: 1.2fr auto 1fr auto 1fr; align-items: center; } }
  .path__arrow { font-family: var(--font-display); font-size: 2rem; font-weight: 800; color: var(--purple-400); text-align: center; }
  .path__big { font-family: var(--font-display); font-weight: 800; font-size: 1.8rem; margin: 0; }
  .card--dark .path__big { color: #fff; }
  .card--dark .eyebrow { color: var(--lime-300); }
  .quote { font-family: var(--font-display); font-size: var(--fs-xl); font-weight: 700; color: var(--purple-600); border-left: 4px solid var(--lime-400); padding-left: 20px; }
</style>
